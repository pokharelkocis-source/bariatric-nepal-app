<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSeverity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_warning"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:text="Medium"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_info"
                android:paddingStart="9dp"
                android:paddingTop="2dp"
                android:paddingEnd="9dp"
                android:paddingBottom="2dp"
                android:text="Pending"
                android:textColor="@color/bn_primary"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/tvComplaintDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/bn_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvComplaintText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Feeling nauseous after eating"
            android:textColor="@color/bn_text"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvDoctorReply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_pill_info"
            android:padding="9dp"
            android:textColor="@color/bn_primary"
            android:textSize="12.5sp"
            android:visibility="gone" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
