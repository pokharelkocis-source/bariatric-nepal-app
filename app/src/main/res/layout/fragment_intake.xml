<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipeRefresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Daily Intake"
                android:textColor="@color/bn_primary"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/tvGoalSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Loading goals…"
                android:textColor="@color/bn_muted"
                android:textSize="12sp"
                android:layout_marginBottom="20dp" />

            <!-- Protein Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🥩  Protein"
                    android:textColor="@color/bn_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressProtein"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvProteinLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0g / 60g"
                    android:textColor="@color/bn_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etProtein"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Protein today (g)"
                    android:inputType="numberDecimal"
                    android:textColor="@color/bn_text"
                    android:textColorHint="@color/bn_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <!-- Water Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💧  Water"
                    android:textColor="@color/bn_text"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <ProgressBar
                    android:id="@+id/progressWater"
                    style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:max="100"
                    android:progress="0"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:id="@+id/tvWaterLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0ml / 2000ml"
                    android:textColor="@color/bn_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/etWater"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Water today (ml)"
                    android:inputType="number"
                    android:textColor="@color/bn_text"
                    android:textColorHint="@color/bn_muted"
                    android:textSize="14sp" />

            </LinearLayout>

            <Button
                android:id="@+id/btnSaveIntake"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_btn_primary"
                android:text="Save Intake"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="15sp"
                android:padding="14dp" />

        </LinearLayout>
    </ScrollView>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
