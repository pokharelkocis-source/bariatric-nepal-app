<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_stat_card"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/tvChartTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Post-Op Month 3 Diet Plan"
        android:textColor="@color/bn_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvChartValidity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/bn_muted"
        android:textSize="11.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/mealsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/tvChartNotes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_info"
        android:padding="9dp"
        android:textColor="@color/bn_primary"
        android:textSize="12sp"
        android:visibility="gone" />

</LinearLayout>
